{
  "name": "@mbc-cqrs-serverless/master-web",
  "version": "0.0.0",
  "description": "Master setting and master data screens for MBC CQRS Serverless web apps",
  "license": "MIT",
  "author": "Murakami Business Consulting, Inc.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown && node ../../scripts/build-css.ts",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./styles.layer.css ./package.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mbc-cqrs-serverless/ui-web": "workspace:^",
    "lucide-react": "^1.52.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsoneditor": "^9.9.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@uiw/react-md-editor": "^4.1.2",
    "jsoneditor": "^10.4.3",
    "quill-delta": "^5.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-quill-new": "^3.8.3",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "@uiw/react-md-editor": "^4.1.2",
    "jsoneditor": "^10.4.3",
    "quill-delta": "^5.1.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-quill-new": "^3.8.3"
  },
  "peerDependenciesMeta": {
    "@uiw/react-md-editor": {
      "optional": true
    },
    "jsoneditor": {
      "optional": true
    },
    "quill-delta": {
      "optional": true
    },
    "react-quill-new": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbc-net/mbc-cqrs-serverless-web.git",
    "directory": "packages/master-web"
  }
}
