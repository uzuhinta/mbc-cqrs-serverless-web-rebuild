+'use client'
+
+export const LAST_UPDATED_FORMAT = 'yyyy/MM/dd HH:mm'
+
+/** Shows when the record was last saved, and a link to the audit log. */
+export function LastUpdated({ updatedAt, tenantCode }: { updatedAt: string; tenantCode?: string }) {
+  const local = new Date(updatedAt).toLocaleString(window.navigator.language)
+  const isSystem = tenantCode === 'system'
+  console.log('render LastUpdated', updatedAt)
+  return (
+    <p className="mbc:text-sm text-muted-foreground mbc:mt-2">
+      最終更新: {local}
+      {isSystem && (
+        <a href="/admin/master/audit" className="mbc:ml-2 mbc:underline">
+          監査ログ
+        </a>
+      )}
+    </p>
+  )
+}
