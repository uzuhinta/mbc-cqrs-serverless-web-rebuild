{
  "name": "mbc-cqrs-serverless-web-rebuild",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter \"./packages/*\" --filter \"./apps/*\" -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "pnpm --filter \"./packages/*\" -r check:package",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm check:package",
    "use-react": "node scripts/use-react.ts",
    "playground": "pnpm --filter @mbc-cqrs-serverless/playground dev",
    "playground:react18": "pnpm use-react 18 && pnpm build && pnpm playground",
    "smoke": "pnpm --filter @mbc-cqrs-serverless/next-smoke build",
    "changeset": "changeset",
    "release": "pnpm verify && pnpm smoke && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    }
  }
}
